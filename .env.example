# Copy this file to .env before running Docker Compose.
JWT_SECRET=change-this-development-secret-to-at-least-32-characters
MONGO_ROOT_USERNAME=marketplace
MONGO_ROOT_PASSWORD=marketplace-dev-password
MINIO_ROOT_USER=marketplace
MINIO_ROOT_PASSWORD=marketplace-dev-password
ALLOWED_ORIGINS=http://localhost:4200,http://localhost
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=60s
MEDIA_RATE_LIMIT_REQUESTS=60
MEDIA_RATE_LIMIT_WINDOW=60s

# Host port overrides. Internal container ports never change.
FRONTEND_HOST_PORT=4200
GATEWAY_HOST_PORT=8080
USER_SERVICE_HOST_PORT=8081
PRODUCT_SERVICE_HOST_PORT=8082
MEDIA_SERVICE_HOST_PORT=8083
DISCOVERY_HOST_PORT=8761
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
KAFKA_HOST_PORT=9092
MONGO_HOST_PORT=27017

# Keep this aligned with GATEWAY_HOST_PORT so image URLs work outside Docker.
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media/images
