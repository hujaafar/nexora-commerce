# BUY-01 learning header
# File purpose: Defines repository/tooling rules through .editorconfig.
# Learning focus: Repository hygiene, consistent text handling, and small build contexts.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.java]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
