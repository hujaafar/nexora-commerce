# File purpose: Defines repository/tooling rules through .gitignore.
# Java / Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Angular / Node
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Runtime data and secrets
.env
data/
uploads/
certs/*.p12
certs/*.pem
!certs/README.md

# Logs
*.log
logs/
