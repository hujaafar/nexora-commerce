# File purpose: Documents the runtime settings and secrets required by the Jenkins stack.
# Copy this file to jenkins/.env and replace every change-me/replace value.
JENKINS_HTTP_PORT=8088
JENKINS_URL=http://localhost:8088/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-before-first-run
JENKINS_ADMIN_EMAIL=admin@example.com
# This least-privilege identity bootstraps the inbound worker connection.
JENKINS_AGENT_ID=agent-bootstrap
JENKINS_AGENT_PASSWORD=change-me-before-first-run

# Local inbox used to demonstrate real success and failure notifications.
MAILPIT_HTTP_PORT=8025
NOTIFICATION_EMAIL=builds@example.com

# Email Extension uses Mailpit by default. For real Gmail delivery, run
# scripts/configure-gmail.ps1; it stores the App Password only in ignored .env.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=unused
SMTP_APP_PASSWORD=unused
SMTP_CREDENTIALS_ID=
SMTP_USE_TLS=false

# SonarQube runs on the Docker Desktop host. Its generated analysis token is
# imported from ignored quality/.env by the Jenkins start script.
SONAR_HOST_URL=http://host.docker.internal:9000
SONAR_TOKEN=imported-from-quality-env

# Optional feature branch for testing a pipeline change before merging.
NEXORA_GIT_BRANCH=main

# Jenkins polls this repository and creates the Pipeline job automatically.
NEXORA_GIT_URL=https://github.com/hujaafar/nexora-commerce.git
# Use a personal password or access token when the repository is private.
# Public GitHub checkout does not use these optional private-repository placeholders.
NEXORA_GIT_USERNAME=replace-with-git-username
NEXORA_GIT_PASSWORD=replace-with-git-password-or-token

# JCasC stores these as masked Jenkins credentials for deployment.
DEPLOY_JWT_SECRET=replace-with-at-least-32-random-characters
DEPLOY_INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
DEPLOY_MONGO_USERNAME=marketplace
DEPLOY_MONGO_PASSWORD=replace-this-mongo-password
DEPLOY_MINIO_USERNAME=marketplace
DEPLOY_MINIO_PASSWORD=replace-this-minio-password

# Optional. Leave disabled to use Jenkins console/email notifications only.
SLACK_WEBHOOK_URL=disabled

# These ports expose the Nginx frontend from the isolated deployment daemon.
STAGING_FRONTEND_PORT=14200
PRODUCTION_FRONTEND_PORT=24200
