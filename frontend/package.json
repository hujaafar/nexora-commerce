{
  "name": "nexora-commerce-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage --coverage-reporters=text-summary --coverage-reporters=cobertura --coverage-reporters=lcov --reporters=junit --reporters=default --output-file=test-results/junit.xml",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "private": true,
  "packageManager": "npm@11.4.1",
  "dependencies": {
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/platform-browser": "21.2.22",
    "@angular/router": "21.2.22",
    "@fontsource/kanit": "^5.3.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.22",
    "@angular/cli": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "undici": "^7.29.0",
    "vite": "7.3.6"
  }
}
