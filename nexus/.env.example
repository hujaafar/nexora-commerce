# Public local endpoints.
NEXUS_BIND_ADDRESS=127.0.0.1
NEXUS_HTTP_PORT=18081
NEXUS_DOCKER_PORT=18082
NEXUS_IMAGE=sonatype/nexus3:3.95.3@sha256:c0b9c4a98e231a5865f67a07cea477c13bd3d5f3cac67746afa28622f9c15296

# The bootstrap script replaces these markers with random local-only values.
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=generate-on-first-run
NEXUS_PUBLISHER_USER=ci-publisher
NEXUS_PUBLISHER_PASSWORD=generate-on-first-run
NEXUS_READER_USER=artifact-reader
NEXUS_READER_PASSWORD=generate-on-first-run

# Repository and application identity.
NEXUS_MAVEN_RELEASES=maven-releases
NEXUS_MAVEN_SNAPSHOTS=maven-snapshots
NEXUS_MAVEN_PROXY=maven-central
NEXUS_MAVEN_GROUP=maven-public
NEXUS_DOCKER_REPOSITORY=docker-hosted
