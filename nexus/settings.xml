<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <!-- Every dependency, including Maven plugins, must travel through Nexus. -->
    <mirrors>
        <mirror>
            <id>nexus-public</id>
            <name>Internal Nexus dependency proxy</name>
            <url>${env.NEXUS_MAVEN_GROUP_URL}</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>

    <!-- Credentials are injected by the shell or Jenkins credential store. -->
    <servers>
        <server>
            <id>nexus-public</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>nexus-releases</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>nexus-snapshots</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>
</settings>
