# File purpose: Lists local SonarQube settings without containing real secrets.
# The start script copies this file to ignored quality/.env and replaces every
# placeholder with a cryptographically random value.
SONAR_HTTP_PORT=9000
SONAR_HOST_URL=http://localhost:9000
SONAR_DOCKER_HOST_URL=http://host.docker.internal:9000

# SonarQube stores projects, rules, issues, and quality history in PostgreSQL.
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=generated-by-start-script

# The system passcode protects selected monitoring endpoints. The admin
# password is changed from the one-time default during the first bootstrap.
SONAR_SYSTEM_PASSCODE=generated-by-start-script
SONAR_ADMIN_PASSWORD=generated-by-start-script

# The bootstrap script creates this token through SonarQube's API. Jenkins and
# GitHub use the token, never the administrator password, to submit analysis.
SONAR_TOKEN=generated-by-start-script
