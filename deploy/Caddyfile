# File purpose: Terminates HTTPS and forwards public traffic to the frontend container.
{$DOMAIN:localhost} {
    encode zstd gzip
    # Preserve the public HTTPS scheme for Spring's exact OAuth callback check.
    handle /api/auth/oauth2/* {
        uri strip_prefix /api
        header Referrer-Policy no-referrer
        header Cache-Control no-store
        reverse_proxy gateway-service:8080
    }
    handle {
        reverse_proxy frontend:80
    }
}
